#!/bin/bash

if [ -z "$1" ]; then
    BUILDMACHINE=`hostname -s`
else
    BUILDMACHINE=$1
fi

case "$BUILDMACHINE" in

# Configuration for rig.
"rig")
echo '
BUILD_DIR := Build-rig
RM := rm -rf
CC := gcc
CCFLAGS := -m64 -g -fPIC -Wall -c -fmessage-length=0 -pthread -DMACOSX
CCDEPENDFLAGS := -MMD -MP -MF"$(@:%.o=%.d)" -MT"$(@:%.o=%.d)"
CXX := g++
CXXFLAGS := -m64 -g -fPIC -Wall -c -fmessage-length=0 -pthread -DMACOSX
CXXDEPENDFLAGS := -MMD -MP -MF"$(@:%.o=%.d)" -MT"$(@:%.o=%.d)"
LD := g++
LDFLAGS := -pthread -lpthread
SHLD := g++
SHLDFLAGS := -bundle -fPIC
SHLDOPTO := -o
USE_VERBOSITY_LEVEL := 10
PROTOBUF_PROTOC := /Network/Servers/sol.scs.uiuc.edu/Volumes/HomeRAID2/Homes/erobert3/usr/Darwin-i386/bin/protoc
PROTOBUF_INCLUDE_DIR := -I/Network/Servers/sol.scs.uiuc.edu/Volumes/HomeRAID2/Homes/erobert3/usr/Darwin-i386/include
PROTOBUF_LIB_DIR := -L/Network/Servers/sol.scs.uiuc.edu/Volumes/HomeRAID2/Homes/erobert3/usr/Darwin-i386/lib
PROTOBUF_LIB := -lprotobuf
HDF5_INCLUDE_DIR := -I/Network/Servers/sol.scs.uiuc.edu/Volumes/HomeRAID2/Homes/erobert3/usr/Darwin-i386/include
HDF5_LIB_DIR := -L/Network/Servers/sol.scs.uiuc.edu/Volumes/HomeRAID2/Homes/erobert3/usr/Darwin-i386/lib
HDF5_LIB := -lhdf5 -lhdf5_hl
USE_MPI := 1
MPI_COMPILE_FLAGS = -DOMPI_SKIP_MPICXX=1 $(shell mpicc --showme:compile)
MPI_LINK_FLAGS = $(shell mpicc --showme:link)
USE_PYTHON := 1
PYTHON_SWIG := /usr/bin/swig
PYTHON_INCLUDE_DIR := -I/usr/include/python2.6
PYTHON_LIB_DIR := -L/usr/lib
PYTHON_LIB := -lpython2.6
USE_CUDA := 0
CUDA_NVCC := /usr/local/cuda/bin/nvcc
CUDA_FLAGS := -m64 --ptxas-options=-v --gpu-architecture compute_20 --gpu-code sm_20 -DMACOSX -DCUDA_3D_GRID_LAUNCH -DCUDA_DOUBLE_PRECISION -DTUNE_MPD_Y_BLOCK_Y_SIZE=16 -DTUNE_MPD_Z_BLOCK_Z_SIZE=8
CUDA_INCLUDE_DIR := -I/usr/local/cuda/include
CUDA_LIB_DIR := -L/usr/local/cuda/lib
CUDA_LIB := -lcuda -lcudart
CUDA_GENERATE_PTX_CODE := 1
CUDA_GENERATE_BIN_CODE := 0
CUDA_GENERATE_ASM_CODE := 0
USE_SBML := 1
SBML_INCLUDE_DIR := -I/Network/Servers/sol.scs.uiuc.edu/Volumes/HomeRAID2/Homes/erobert3/usr/Darwin-i386/include
SBML_LIB_DIR := -L/Network/Servers/sol.scs.uiuc.edu/Volumes/HomeRAID2/Homes/erobert3/usr/Darwin-i386/lib
SBML_LIB := -lsbml
USE_PROF := 0
PROF_CUDA_ENABLE := 0
PROF_MAX_THREADS := 15
PROF_MAX_EVENTS := 1000000
PROF_OUT_FILE := timing.prof
USE_BOOST := 1
BOOST_TEST_CXXFLAGS := -DBOOST_TEST_DYN_LINK
BOOST_TEST_INCLUDE_DIR := -I/Network/Servers/sol.scs.uiuc.edu/Volumes/HomeRAID2/Homes/erobert3/usr/Darwin-i386/include
BOOST_TEST_LIB_DIR := -L/Network/Servers/sol.scs.uiuc.edu/Volumes/HomeRAID2/Homes/erobert3/usr/Darwin-i386/lib
BOOST_TEST_LIB := -lboost_unit_test_framework
USE_VMD := 1
VMD_INCLUDE_DIR := -I/Applications/VMD.app/Contents/vmd/plugins/include
VMD_INSTALL_DIR := /Network/Servers/sol.scs.uiuc.edu/Volumes/HomeRAID2/Homes/erobert3/usr/Darwin-i386/lib/vmd/molfile
INSTALL_PREFIX := /Network/Servers/sol.scs.uiuc.edu/Volumes/HomeRAID2/Homes/erobert3/usr/Darwin-i386
' > local.mk
;;

# Configuration for hhpc.
"hhpc")
echo '
BUILD_DIR := Build-hhpc
RM := rm -rf
CC := gcc
CCFLAGS := -m64 -march=core2 -O3 -fPIC -Wall -c -fmessage-length=0 -pthread -DLINUX
CXX := g++
CXXFLAGS := -m64 -march=core2 -O3 -fPIC -Wall -c -fmessage-length=0 -pthread -DLINUX
LD := g++
LDFLAGS := -pthread -lpthread -lrt
SHLD :=
SHLDFLAGS :=
SHLDOPTO :=
USE_VERBOSITY_LEVEL := 4
PROTOBUF_PROTOC := /home/eroberts/usr/bin/protoc
PROTOBUF_INCLUDE_DIR := -I/home/eroberts/usr/include
PROTOBUF_LIB_DIR := -L/home/eroberts/usr/lib
PROTOBUF_LIB := -lprotobuf
HDF5_INCLUDE_DIR := -I/usr/local/include
HDF5_LIB_DIR := -L/usr/local/lib
HDF5_LIB := -lhdf5 -lhdf5_hl
USE_MPI := 1
MPI_COMPILE_FLAGS = -DOMPI_SKIP_MPICXX=1 $(shell mpicc --showme:compile)
MPI_LINK_FLAGS = $(shell mpicc --showme:link)
USE_PYTHON := 1
PYTHON_SWIG := /home/eroberts/usr/bin/swig
PYTHON_INCLUDE_DIR := -I/usr/include/python2.6
PYTHON_LIB_DIR := -L/usr/lib64
PYTHON_LIB := -lpython2.6
USE_CUDA := 0
CUDA_NVCC :=
CUDA_FLAGS := 
CUDA_INCLUDE_DIR :=
CUDA_LIB_DIR :=
CUDA_LIB :=
CUDA_GENERATE_PTX_CODE :=
CUDA_GENERATE_BIN_CODE :=
CUDA_GENERATE_ASM_CODE :=
USE_SBML := 0
SBML_INCLUDE_DIR := 
SBML_LIB_DIR := 
SBML_LIB := 
USE_PROF := 0
PROF_CUDA_ENABLE := 0
PROF_MAX_THREADS := 15
PROF_MAX_EVENTS := 1000000
PROF_OUT_FILE := timing.prof
USE_BOOST := 0
BOOST_TEST_CXXFLAGS := 
BOOST_TEST_INCLUDE_DIR := 
BOOST_TEST_LIB_DIR := 
BOOST_TEST_LIB := 
USE_VMD := 0
VMD_INCLUDE_DIR :=
VMD_INSTALL_DIR :=
INSTALL_PREFIX := /home/eroberts/usr
' > local.mk
;;

*)
echo "Unknown hostname: $BUILDMACHINE"
exit
;;
esac

