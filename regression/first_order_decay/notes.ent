
# Try with no limits.
rm first_order_decay.lm && lm_sbml_import first_order_decay.lm first_order_decay.sbml
lm_setp first_order_decay.lm writeInterval=1e-2

# Try with time limit.
filename="output/first_order_decay_time_limit.lm"
rm -f ${filename} && lm_sbml_import ${filename} first_order_decay.sbml
lm_setp ${filename} maxTime=1e0 writeInterval=1e-2 maxWorkUnitSteps=500
#lmes -r 1-1000 -f ${filename} -g 0 -gr 0 -c 2 -cr 1 | tee ${filename}.log
lmes -r 1-2 -f ${filename} -g 1 -gr 1/6 -c 8 -cr 1 -ca | tee ${filename}.log

# Try with upper species limit.
rm first_order_decay.lm && lm_sbml_import first_order_decay.lm first_order_decay.sbml
lm_setp first_order_decay.lm "speciesUpperLimitList=0:150" writeInterval=1e-2

# Try with lower species limit.
rm first_order_decay.lm && lm_sbml_import first_order_decay.lm first_order_decay.sbml
lm_setp first_order_decay.lm "speciesLowerLimitList=0:150" writeInterval=1e-2

# Try with first passage time.
rm first_order_decay.lm && lm_sbml_import first_order_decay.lm first_order_decay.sbml
lm_setp first_order_decay.lm maxTime=2e-1 writeInterval=1e-2 fptTrackingList=0

# Create a small sfile.
rm first_order_decay.lm && lm_sbml_import first_order_decay.lm first_order_decay.sbml
lm_setp first_order_decay.lm maxTime=1e1 writeInterval=1e-2
lmes -r 1-1 -f first_order_decay.lm -g 0 -gr 0 -c 2 -cr 1 -fo output-small.sfile -ff sfile

rm first_order_decay.lm && lm_sbml_import first_order_decay.lm first_order_decay.sbml
lm_setp first_order_decay.lm maxTime=1e1 writeInterval=1e-2
lmes -r 1-1000 -f first_order_decay.lm -g 0 -gr 0 -c 2 -cr 1 -fo output-large.sfile -ff sfile

